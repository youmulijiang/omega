{
  "name": "@youmulijiang/omega",
  "version": "0.1.0",
  "private": false,
  "description": "OMEGA coding agent",
  "type": "module",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "omega": "./dist/cli.js"
  },
  "main": "./dist/entry.js",
  "types": "./dist/entry.d.ts",
  "scripts": {
    "clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json && shx cp -r src/subagents/agents dist/subagents/agents && shx cp -r src/prompts/*.md dist/prompts && shx cp src/background/core/delegate/hook-contract-evidence.json dist/background/core/delegate/hook-contract-evidence.json && shx chmod +x dist/cli.js dist/bun/cli.js",
    "build:browser-plugin": "node ../../scripts/package-browser-plugin.mjs",
    "test": "vitest --run"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.86.1",
    "@earendil-works/pi-coding-agent": "0.86.1",
    "@earendil-works/pi-tui": "0.86.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@narumitw/pi-tui-kit": "0.56.0",
    "acorn": "8.16.0",
    "turndown": "7.2.4",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/turndown": "5.0.6",
    "shx": "0.4.0",
    "vitest": "4.1.9"
  }
}
