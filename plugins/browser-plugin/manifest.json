{
	"manifest_version": 3,
	"name": "Omega Browser Bridge",
	"version": "1.0.0",
	"description": "Bridge that lets the Omega agent control this Chrome profile (tabs, navigation, scripts, screenshots) over a local WebSocket.",
	"minimum_chrome_version": "116",
	"permissions": ["tabs", "scripting", "storage", "cookies", "sidePanel", "alarms"],
	"host_permissions": ["<all_urls>"],
	"background": {
		"service_worker": "background.js"
	},
	"side_panel": {
		"default_path": "sidepanel.html"
	},
	"action": {
		"default_title": "Omega Browser Bridge",
		"default_icon": "icon.png",
		"default_popup": "popup.html"
	},
	"icons": {
		"128": "icon.png"
	}
}
